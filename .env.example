APP_ENV=development
AUTH_MODE=demo                 # demo | jwt

DATABASE_URL=postgresql+psycopg://postgres.your_project_ref:YOUR_DB_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
SUPABASE_URL=https://your_project_ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_JWT_SECRET=           # for jwt mode

LLM_PROVIDER=google            # google | openai
LLM_API_KEY=
LLM_MODEL=gemini-2.0-flash
EMBEDDING_PROVIDER=google      # google | openai
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIM=768

MAX_TOOL_CALLS=5
LLM_TIMEOUT_S=20
DB_TIMEOUT_S=5
RAG_TOP_K=4
RAG_MIN_SIMILARITY=0.35
LOG_LEVEL=INFO
ORDER_CLIENT=local             # local | http
SIMULATE_FAILURE=              # orders_timeout | db_down | llm_down (dev only)
